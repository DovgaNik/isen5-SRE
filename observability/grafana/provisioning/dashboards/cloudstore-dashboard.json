      },
      "targets": [
        {
          "expr": "((histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-b-catalog\"}[1m])))) / (histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-b-catalog\"}[1m]))))) or vector(1)",
