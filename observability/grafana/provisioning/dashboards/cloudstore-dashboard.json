    {
      "id": 1,
      "title": "SRE Specification: SLI, SLO & SLA Contract (Services B & D)",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"font-size: 13px; line-height: 1.4; padding: 2px 4px;\">\n<table style=\"width: 100%; border-collapse: collapse; text-align: left;\">\n  <thead>\n    <tr style=\"border-bottom: 2px solid #555; color: #8ab4f8; font-size: 12px; text-transform: uppercase;\">\n      <th style=\"padding: 4px 6px;\">Objective</th>\n      <th style=\"padding: 4px 6px;\">SLI Definition</th>\n      <th style=\"padding: 4px 6px;\">SLO (5m)</th>\n      <th style=\"padding: 4px 6px;\">SLA (1h)</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr style=\"border-bottom: 1px solid #333;\">\n      <td style=\"padding: 6px 6px; font-weight: bold;\">Availability</td>\n      <td style=\"padding: 6px 6px;\"><code>1 - (5xx / Total)</code></td>\n      <td style=\"padding: 6px 6px; color: #73BF69; font-weight: bold;\">≥ 99.5%</td>\n      <td style=\"padding: 6px 6px; color: #FADE2A;\">≥ 99.0%</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #333;\">\n      <td style=\"padding: 6px 6px; font-weight: bold;\">Service B Latency</td>\n      <td style=\"padding: 6px 6px;\">Catalog p95 Duration</td>\n      <td style=\"padding: 6px 6px; color: #73BF69; font-weight: bold;\">≤ 100 ms</td>\n      <td style=\"padding: 6px 6px; color: #FADE2A;\">≤ 250 ms</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #333;\">\n      <td style=\"padding: 6px 6px; font-weight: bold;\">Service D Latency</td>\n      <td style=\"padding: 6px 6px;\">Payment p95 Duration</td>\n      <td style=\"padding: 6px 6px; color: #73BF69; font-weight: bold;\">≤ 250 ms</td>\n      <td style=\"padding: 6px 6px; color: #FADE2A;\">≤ 500 ms</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 6px 6px; font-weight: bold;\">Error Budget</td>\n      <td style=\"padding: 6px 6px;\"><code>1 - (5xx / (Total × 1%))</code></td>\n      <td style=\"padding: 6px 6px; color: #73BF69; font-weight: bold;\">&gt; 0% left</td>\n      <td style=\"padding: 6px 6px; color: #F2495C;\">Breach: ≤ 0%</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
      }
    },
    {
      "id": 2,
      "title": "Availability SLI (Target: ≥99.5%)",
      "type": "gauge",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(1 - (sum(rate(http_requests_total{job=~\"$service\", route=~\"$route\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=~\"$service\", route=~\"$route\"}[5m])))) * 100 or vector(100)",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 90,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99.0
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          }
        }
      }
    },
